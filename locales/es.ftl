# Assignment types
type-definition-quiz-title = ¿Qué significa la expresión?
type-definition-quiz-body = Elige la definición correcta.
type-definition-quiz-example-title = Ejemplo
type-definition-quiz-example-body =
    <b>Frase:</b> break the ice
    🇦 Say something funny to make people feel relaxed
    🇧 Literally break something
    🇨 Freeze water

    💡 <b>Respuesta correcta:</b> 🇦 Say something funny to make people feel relaxed
type-definition-quiz-note = { "" }

type-gap-filling-title = Rellena el hueco
type-gap-filling-body = Escribe la palabra o frase que falta. Tienes <b>tres intentos</b>.
type-gap-filling-example-title = Ejemplo
type-gap-filling-example-body =
    I don't <u>_____</u> mango.
    <b>Respuesta:</b> like
type-gap-filling-note = { "" }

type-phrase-fail-title = Encuentra la oración incorrecta
type-phrase-fail-body = Tres oraciones usan la misma frase. En una de ellas es <b>incorrecta</b>. Escribe el número.
type-phrase-fail-example-title = Ejemplo
type-phrase-fail-example-body =
    <b>Frase:</b> get up
    1. I <b>get up</b> at 7 a.m.
    2. He <b>get up</b> at 5 a.m. today.
    3. She <b>gets up</b> early every day.

    <b>Respuesta:</b> 2
    💡 <b>Correcto:</b> He <b>gets up</b> at 5 a.m. today.
type-phrase-fail-note = 💡 Consejo: fíjate en la forma verbal y el orden de las palabras.

type-collocation-check-title = Encuentra la palabra común
type-collocation-check-body = Cuatro frases usan la misma palabra. Escribe esa palabra.
type-collocation-check-example-title = Ejemplo
type-collocation-check-example-body =
    1. ____ a decision
    2. ____ a living
    3. ____ progress
    4. ____ a sandwich

    <b>Respuesta:</b> <b>make</b>

    <i>Traducción:</i>
    make a decision — tomar una decisión
    make a living — ganarse la vida
    make progress — progresar
    make a sandwich — hacer un sándwich
type-collocation-check-note = { "" }

