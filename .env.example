# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# URL of the backend API (e.g. http://backend:4000)
BACKEND_BASE_URL=

# Shared secret between this bot and the backend for internal webhooks
# Generate with: openssl rand -hex 32
TELEGRAM_BOT_INTERNAL_TOKEN=

# Upstash Redis REST credentials (for session storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
NODE_ENV=production
PORT=80

# Public website base URL, used for links to legal pages (Terms, Privacy). Defaults to https://www.lexi-buddy.com
# Leave empty to use the default. If set, must be an absolute http(s) URL — the bot fails to start otherwise.
WEBSITE_BASE_URL=

# Optional student-facing media overlays (Telegram file_id).
# Leave empty to keep sending the current plain-text message for that scenario — this is the normal, supported state.
# Can be set/changed/cleared at any time by editing the env and restarting the service; no rebuild needed.
TELEGRAM_GIF_STUDENT_WELCOME_FILE_ID=
TELEGRAM_GIF_STUDENT_MAIN_MENU_FILE_ID=
TELEGRAM_GIF_TEACHER_REQUEST_ACCEPTED_FILE_ID=
TELEGRAM_GIF_STUDENT_LESSON_ASSIGNED_FILE_ID=
TELEGRAM_VIDEO_STUDENT_TASK_RESULT_LOW_FILE_ID=
TELEGRAM_VIDEO_STUDENT_RESULT_POSITIVE_FILE_ID=

# Optional admin-only diagnostic handler for obtaining Telegram file_id values (animation/video/document).
# Off by default. Set to "true" and list allowed Telegram user IDs to enable — set independently per bot (dev/prod).
# Sending an unsupported document type or being outside the allowlist never reveals that this handler exists.
TELEGRAM_MEDIA_REGISTRATION_ENABLED=false
# Comma-separated Telegram numeric user IDs, e.g. "111111111,222222222"
TELEGRAM_MEDIA_ADMIN_IDS=
